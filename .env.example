# Local-only mode binds 127.0.0.1; never expose without authenticated reverse proxy.
VEAB_HOST=127.0.0.1
VEAB_PORT=8000
VEAB_DATA_DIR=./artifacts
# Set a strong token before exposing VEAB to any network.
# VEAB_ADMIN_TOKEN=replace-with-long-random-token
# HMAC attestation: protect key externally, rotate separately from benchmark data.
# VEAB_ATTESTATION_KEY=replace-with-long-random-secret
# Optional, not required for the deterministic benchmark:
# OPENROUTER_API_KEY=...
# OPENROUTER_MODEL=...
