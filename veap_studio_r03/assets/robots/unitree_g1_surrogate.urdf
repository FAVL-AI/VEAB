<robot name="unitree_g1_surrogate">
  <link name="pelvis"/>
  <link name="torso_link"/>
  <link name="head_link"/>
  <link name="left_hip_pitch_link"/>
  <link name="left_knee_link"/>
  <link name="left_ankle_pitch_link"/>
  <link name="right_hip_pitch_link"/>
  <link name="right_knee_link"/>
  <link name="right_ankle_pitch_link"/>
  <link name="left_shoulder_pitch_link"/>
  <link name="left_elbow_link"/>
  <link name="right_shoulder_pitch_link"/>
  <link name="right_elbow_link"/>
  <joint name="waist_yaw_joint" type="revolute"><parent link="pelvis"/><child link="torso_link"/></joint>
  <joint name="head_joint" type="fixed"><parent link="torso_link"/><child link="head_link"/></joint>
  <joint name="left_hip_pitch_joint" type="revolute"><parent link="pelvis"/><child link="left_hip_pitch_link"/></joint>
  <joint name="left_knee_joint" type="revolute"><parent link="left_hip_pitch_link"/><child link="left_knee_link"/></joint>
  <joint name="left_ankle_pitch_joint" type="revolute"><parent link="left_knee_link"/><child link="left_ankle_pitch_link"/></joint>
  <joint name="right_hip_pitch_joint" type="revolute"><parent link="pelvis"/><child link="right_hip_pitch_link"/></joint>
  <joint name="right_knee_joint" type="revolute"><parent link="right_hip_pitch_link"/><child link="right_knee_link"/></joint>
  <joint name="right_ankle_pitch_joint" type="revolute"><parent link="right_knee_link"/><child link="right_ankle_pitch_link"/></joint>
  <joint name="left_shoulder_pitch_joint" type="revolute"><parent link="torso_link"/><child link="left_shoulder_pitch_link"/></joint>
  <joint name="left_elbow_joint" type="revolute"><parent link="left_shoulder_pitch_link"/><child link="left_elbow_link"/></joint>
  <joint name="right_shoulder_pitch_joint" type="revolute"><parent link="torso_link"/><child link="right_shoulder_pitch_link"/></joint>
  <joint name="right_elbow_joint" type="revolute"><parent link="right_shoulder_pitch_link"/><child link="right_elbow_link"/></joint>
</robot>
