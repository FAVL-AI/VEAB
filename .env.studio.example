# VEAP Assurance Studio 0.5 — SINGLE-HOST RESEARCH PILOT ONLY
VEAP_STUDIO_AUTH_MODE=dev-token
VEAP_STUDIO_RELEASE=pilot
VEAP_STUDIO_DATA_DIR=./studio-data
# Optional local-only HMAC; use external secrets management for any deployed service.
# VEAP_STUDIO_BUNDLE_HMAC_KEY=GENERATE_A_LONG_RANDOM_SECRET_OUTSIDE_GIT
# Real OIDC is supported at the token-validation boundary but requires a configured provider,
# TLS at the edge, an administrator-created issuer/subject mapping, and production security review.
# VEAP_STUDIO_AUTH_MODE=oidc
# VEAP_OIDC_ISSUER=https://issuer.example/
# VEAP_OIDC_AUDIENCE=veap-studio-api
# VEAP_OIDC_JWKS_URL=https://issuer.example/.well-known/jwks.json
# Do not set VEAP_STUDIO_RELEASE=production: this build correctly refuses to start.
