# Development/pilot container, not a production-certified container image.
FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY pyproject.toml README.md ./
COPY veab ./veab
COPY web ./web
COPY scenarios ./scenarios
COPY assets/generated ./assets/generated
RUN pip install --no-cache-dir --upgrade pip && pip install --no-cache-dir -e . \
  && useradd --system --create-home --home-dir /home/veab veab \
  && mkdir -p /app/studio-data && chown -R veab:veab /app/studio-data
USER veab
EXPOSE 8010
CMD ["uvicorn","veab.enterprise.api:app","--host","0.0.0.0","--port","8010","--workers","1"]
